<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);SYSLIB0014;SYSLIB0050</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(F10QueueEnginePath)' != ''">
    <DefineConstants>$(DefineConstants);F10_QUEUE_ENGINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(F10QueueEnginePath)' != ''">
    <Content Include="$(F10QueueEnginePath)" Link="engine/ffmpeg-queue.exe" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="VerifyQueueEngine" BeforeTargets="PrepareForBuild" Condition="'$(F10QueueEnginePath)' != ''">
    <GetFileHash Files="$(F10QueueEnginePath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="QueueEngineHash" />
    </GetFileHash>
    <Error Condition="'$(QueueEngineHash)' != '4A1AF73D7E64DCA262A435A72D2D292FDBAB877BAE786036169C497DFEA9076A'" Text="The supplied queue engine differs from the approved binary." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="F10Recorder.WorkerChecks" />
    <ProjectReference Include="../F10Recorder.Core/F10Recorder.Core.csproj" />
    <Compile Include="../../src/ReplayEngine.cs" Link="ReplayEngine.cs" />
    <Compile Include="../../src/Native.cs" Link="Native.cs" />
    <Compile Include="../../src/WindowCaptureTarget.cs" Link="WindowCaptureTarget.cs" />
    <Compile Include="../../src/LoopbackAudio.cs" Link="LoopbackAudio.cs" />
    <Compile Include="../../src/MediaDependency.cs" Link="MediaDependency.cs" />
    <Compile Include="../../src/TrustedStorage.cs" Link="TrustedStorage.cs" />
    <Compile Include="../../src/AudioPipe.cs" Link="AudioPipe.cs" />
    <Compile Include="../../src/EncoderCapabilities.cs" Link="EncoderCapabilities.cs" />
    <Compile Include="../../src/ApplicationFolders.cs" Link="ApplicationFolders.cs" />
    <Compile Include="../../src/ScreenshotCapture.cs" Link="ScreenshotCapture.cs" />
  </ItemGroup>
</Project>

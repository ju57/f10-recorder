--- /dev/null
+++ b/libavfilter/queue_worker.h
@@ -0,0 +1,148 @@
+/* Private, single-context, wait-triggered producer. No graph calls on the helper. */
+#include <process.h>
+#include <windows.h>
+#include <stdint.h>
+
+typedef struct QueueItem {
+    int slot;
+    int64_t pts, bucket;
+} QueueItem;
+
+typedef struct QueueWorker {
+    CRITICAL_SECTION data;
+    HANDLE changed, thread, timer;
+    volatile LONG stopping, waiting, generation;
+    LONG error;
+    int initialized, count;
+    int64_t anchor, frequency;
+    QueueItem items[3];
+    void *opaque;
+    int (*poll)(void *);
+} QueueWorker;
+
+void f10_queue_fps_first(int64_t normalized);
+void f10_queue_wait(int waiting);
+
+static SRWLOCK registration = SRWLOCK_INIT;
+static QueueWorker *active_queue;
+static volatile LONG64 initial_raw = -1, clock_offset = INT64_MIN;
+
+void f10_queue_fps_first(int64_t normalized)
+{
+    int64_t raw = InterlockedCompareExchange64(&initial_raw,0,0);
+    if (raw >= 0) InterlockedCompareExchange64(&clock_offset,normalized-raw,INT64_MIN);
+}
+
+void f10_queue_wait(int waiting)
+{
+    AcquireSRWLockShared(&registration);
+    if (active_queue) {
+        InterlockedIncrement(&active_queue->generation);
+        InterlockedExchange(&active_queue->waiting,waiting);
+        SetEvent(active_queue->changed);
+    }
+    ReleaseSRWLockShared(&registration);
+}
+
+static int64_t queue_now(void)
+{
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    return t.QuadPart;
+}
+
+static QueueItem queue_pop(QueueWorker *q)
+{
+    QueueItem item=q->items[0];
+    memmove(q->items,q->items+1,(--q->count)*sizeof(item));
+    return item;
+}
+
+/* Return the first free dedicated texture, or transfer the oldest pending slot. */
+static int queue_reserve(QueueWorker *q,int64_t bucket,QueueItem *evicted)
+{
+    evicted->slot=-1;
+    if (q->count && q->items[q->count-1].bucket==bucket) return -1;
+    if (q->count==3) {
+        *evicted=queue_pop(q);
+        return evicted->slot;
+    }
+    int used=0;
+    for (int i=0;i<q->count;i++) used |= 1<<q->items[i].slot;
+    for (int i=0;i<3;i++) if (!(used & (1<<i))) return i;
+    return -2;
+}
+
+static unsigned __stdcall queue_thread(void *opaque)
+{
+    QueueWorker *q=opaque;
+    HANDLE signals[]={q->changed,q->timer};
+    int64_t last=0;
+    while (!InterlockedCompareExchange(&q->stopping,0,0)) {
+        if (!InterlockedCompareExchange(&q->waiting,0,0)) {
+            WaitForSingleObject(q->changed,INFINITE);
+            continue;
+        }
+        EnterCriticalSection(&q->data);
+        int64_t base=q->anchor, now=queue_now();
+        int64_t previous=last>base?last:base;
+        int64_t tick=base+(1+(previous-base)*240/q->frequency)*q->frequency/240;
+        if (tick<=previous) tick=base+((previous-base)*240/q->frequency+2)*q->frequency/240;
+        int allowed=base>0 && q->waiting && !q->stopping &&
+                    InterlockedCompareExchange64(&clock_offset,0,0)!=INT64_MIN;
+        if (allowed && now>=tick) {
+            q->error=q->poll(q->opaque);
+            last=queue_now();
+        }
+        int failed=q->error<0;
+        LeaveCriticalSection(&q->data);
+        if (failed) break;
+        if (allowed && now>=tick) continue;
+        LARGE_INTEGER due;
+        due.QuadPart=allowed ? -((tick-now)*10000000/q->frequency+1) : -41667;
+        if (!SetWaitableTimer(q->timer,&due,0,NULL,NULL,FALSE) ||
+            WaitForMultipleObjects(2,signals,FALSE,INFINITE)==WAIT_FAILED) {
+            EnterCriticalSection(&q->data); q->error=-1; LeaveCriticalSection(&q->data); break;
+        }
+    }
+    return 0;
+}
+
+static void queue_stop(QueueWorker *q)
+{
+    if (!q->initialized) return;
+    AcquireSRWLockExclusive(&registration);
+    if (active_queue==q) active_queue=NULL;
+    ReleaseSRWLockExclusive(&registration);
+    InterlockedExchange(&q->stopping,1);
+    if (q->changed) SetEvent(q->changed);
+    if (q->thread) { WaitForSingleObject(q->thread,INFINITE); CloseHandle(q->thread); }
+    if (q->timer) CloseHandle(q->timer);
+    if (q->changed) CloseHandle(q->changed);
+    DeleteCriticalSection(&q->data);
+    q->initialized=0;
+}
+
+static int queue_start(QueueWorker *q,void *opaque,int (*poll)(void *))
+{
+    LARGE_INTEGER freq;
+    InitializeCriticalSection(&q->data);
+    q->initialized=1; q->opaque=opaque; q->poll=poll;
+    if (!QueryPerformanceFrequency(&freq)) goto fail;
+    q->frequency=freq.QuadPart;
+    q->changed=CreateEventW(NULL,FALSE,FALSE,NULL);
+    q->timer=CreateWaitableTimerExW(NULL,NULL,CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,TIMER_ALL_ACCESS);
+    if (!q->timer || !q->changed) goto fail;
+    q->thread=(HANDLE)_beginthreadex(NULL,0,queue_thread,q,0,NULL);
+    if (!q->thread) goto fail;
+    AcquireSRWLockExclusive(&registration);
+    if (active_queue) { ReleaseSRWLockExclusive(&registration); goto fail; }
+    InterlockedExchange64(&initial_raw,-1);
+    InterlockedExchange64(&clock_offset,INT64_MIN);
+    active_queue=q;
+    ReleaseSRWLockExclusive(&registration);
+    return 0;
+fail:
+    queue_stop(q);
+    return -1;
+}

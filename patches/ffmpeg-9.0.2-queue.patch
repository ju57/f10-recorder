+/* Fixed 60 Hz cadence for a D3D11 source sampled on the common audio/video
+ * acquisition clock. The producer and timer serialize through DelayDevice.lock.
+ * Queued hardware frames own their textures and are never mutated after publish. */
+#ifndef AVFILTER_F10_DELAY_SELECTOR_H
+#define AVFILTER_F10_DELAY_SELECTOR_H
+#include "libavutil/frame.h"
+#include "libavutil/mathematics.h"
+
+#define DELAY_INPUTS 32
+#define DELAY_OUTPUTS 32
+
+typedef struct DelayPicture {
+    AVFrame *frame;
+    int64_t ready, bucket;
+} DelayPicture;
+
+typedef struct DelaySelector {
+    int64_t epoch, hz;
+    DelayPicture input[DELAY_INPUTS];
+    AVFrame *current;
+    unsigned head, count;
+} DelaySelector;
+
+static int64_t delay_due(const DelaySelector *s, int64_t slot)
+{
+    return s->epoch + av_rescale_rnd(slot + 1, s->hz, 60, AV_ROUND_UP);
+}
+
+/* Both the underlying desktop and any composited cursor must be eligible for
+ * this output slot. The caller retains the frame if publication fails. */
+static int delay_publish(DelaySelector *s, AVFrame *frame, int64_t present,
+                         int64_t cursor, int64_t ready)
+{
+    if (!frame || present <= 0 || cursor < 0 || present > ready ||
+        cursor > ready || ready < s->epoch || s->hz <= 0)
+        return AVERROR_INVALIDDATA;
+    if (s->count == DELAY_INPUTS)
+        return AVERROR(ENOBUFS);
+
+    int64_t stamp = FFMAX(present, cursor);
+    int64_t us = av_rescale(FFMAX(stamp - s->epoch, 0), 1000000, s->hz);
+    s->input[(s->head + s->count) % DELAY_INPUTS] = (DelayPicture) {
+        frame, ready, av_rescale(us, 60, 1000000)
+    };
+    s->count++;
+    return 0;
+}
+
+static int delay_pick(DelaySelector *s, int64_t slot, int64_t wake, AVFrame **result)
+{
+    int64_t due = delay_due(s, slot);
+    if (slot < 0 || wake < due)
+        return AVERROR(EINVAL);
+    *result = NULL;
+    while (s->count) {
+        DelayPicture *p = &s->input[s->head];
+        if (p->ready > due || p->bucket > slot)
+            break;
+        av_frame_free(&s->current);
+        s->current = p->frame;
+        p->frame = NULL;
+        s->head = (s->head + 1) % DELAY_INPUTS;
+        s->count--;
+    }
+    if (!s->current)
+        return 0;
+    AVFrame *out = av_frame_clone(s->current);
+    if (!out)
+        return AVERROR(ENOMEM);
+    out->pts = slot;
+    out->duration = 1;
+    out->time_base = (AVRational){1, 60};
+    *result = out;
+    return 0;
+}
+
+static void delay_clear(DelaySelector *s)
+{
+    for (unsigned i = 0; i < DELAY_INPUTS; i++)
+        av_frame_free(&s->input[i].frame);
+    av_frame_free(&s->current);
+}
+#endif

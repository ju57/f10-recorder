+++ b/libavfilter/queue_capture.h
@@ -0,0 +1,66 @@
+/* Snapshots are owned by the queue until copied to a downstream surface. */
+static ID3D11Texture2D *queue_take(DdagrabContext *d, int64_t *pts)
+{
+    QueueItem item = queue_pop(&d->queue);
+    ID3D11Texture2D *snapshot = d->snapshots[item.slot];
+    ID3D11Texture2D_AddRef(snapshot);
+    *pts = item.pts;
+    return snapshot;
+}
+
+static int queue_poll_locked(AVFilterContext *ctx)
+{
+    DdagrabContext *d=ctx->priv;
+    QueueWorker *q=&d->queue;
+    if (!InterlockedCompareExchange(&q->waiting,0,0) || InterlockedCompareExchange(&q->stopping,0,0)) return 0;
+    ID3D11Texture2D *texture=NULL;
+    int64_t timeout=d->time_timeout;
+    d->time_timeout=0;
+    int ret=next_frame_internal(ctx,&texture,0);
+    d->time_timeout=timeout;
+    if (ret==AVERROR(EAGAIN)) return 0;
+    if (ret<0) return ret;
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D_GetDesc(texture,&desc);
+    if (desc.Width!=1920 || desc.Height!=1080 || desc.Format!=DXGI_FORMAT_B8G8R8A8_UNORM ||
+        desc.ArraySize!=1 || desc.MipLevels!=1 || desc.SampleDesc.Count!=1) {
+        ret=AVERROR_OUTPUT_CHANGED; goto finish;
+    }
+    int64_t pts=av_gettime_relative()-d->first_pts;
+    int64_t normalized=pts+InterlockedCompareExchange64(&clock_offset,0,0);
+    int64_t bucket=av_rescale_q_rnd(normalized,AV_TIME_BASE_Q,(AVRational){1,60},AV_ROUND_NEAR_INF);
+    QueueItem evicted;
+    int slot=queue_reserve(q,bucket,&evicted);
+    if (slot==-1) goto finish;
+    if (slot<0) { ret=AVERROR_BUG; goto finish; }
+    if (!d->snapshots[slot]) {
+        desc.Usage=D3D11_USAGE_DEFAULT; desc.BindFlags=D3D11_BIND_RENDER_TARGET;
+        desc.CPUAccessFlags=0; desc.MiscFlags=0;
+        if (FAILED(ID3D11Device_CreateTexture2D(d->device_hwctx->device,&desc,NULL,&d->snapshots[slot]))) {
+            ret=AVERROR(ENOMEM); goto finish;
+        }
+    }
+    ID3D11DeviceContext_CopyResource(d->device_hwctx->device_context,(ID3D11Resource*)d->snapshots[slot],(ID3D11Resource*)texture);
+    if (d->draw_mouse) {
+        AVFrame target={0};
+        target.data[0]=(uint8_t*)d->snapshots[slot];
+        ret=draw_mouse_pointer(ctx,&target);
+        ID3D11DeviceContext_OMSetRenderTargets(d->device_hwctx->device_context,0,NULL,NULL);
+        if (ret<0) goto finish;
+    }
+    q->items[q->count++]=(QueueItem){slot,pts,bucket};
+finish:
+    release_resource(&texture);
+    if (FAILED(IDXGIOutputDuplication_ReleaseFrame(d->dxgi_outdupl))) return AVERROR_EXTERNAL;
+    return ret;
+}
+
+static int queue_poll(void *opaque)
+{
+    AVFilterContext *ctx=opaque;
+    DdagrabContext *d=ctx->priv;
+    d->device_hwctx->lock(d->device_hwctx->lock_ctx);
+    int ret=queue_poll_locked(ctx);
+    d->device_hwctx->unlock(d->device_hwctx->lock_ctx);
+    return ret;
+}
--- /dev/null
+++ b/libavfilter/startup_wait.h
@@ -0,0 +1,27 @@
+/* Private queue-on probe only, before the first texture is transferred. */
+static int startup_wait(AVFilterContext *avctx)
+{
+    DdagrabContext *dda = avctx->priv;
+    const int64_t saved_timeout = dda->time_timeout;
+    const int64_t deadline = startup_now_us() + 64000;
+    int ret;
+    for (;;) {
+        const int64_t remaining_ms = (deadline - startup_now_us()) / 1000;
+        if (startup_interrupted()) { ret = AVERROR_EXIT; break; }
+        if (remaining_ms <= 0) { ret = AVERROR(ETIMEDOUT); break; }
+        dda->time_timeout = remaining_ms < 8 ? remaining_ms : 8;
+        ret = next_frame_internal(avctx, &dda->probed_texture, 1);
+        if (ret != AVERROR(EAGAIN)) break;
+    }
+    dda->time_timeout = saved_timeout;
+    if (ret == 0) {
+        int interrupted = startup_interrupted();
+        if (interrupted || startup_now_us() >= deadline) {
+            release_resource(&dda->probed_texture);
+            HRESULT hr = IDXGIOutputDuplication_ReleaseFrame(dda->dxgi_outdupl);
+            if (FAILED(hr)) return AVERROR_EXTERNAL;
+            return interrupted ? AVERROR_EXIT : AVERROR(ETIMEDOUT);
+        }
+    }
+    return ret;
+}

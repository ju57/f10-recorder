+#include "delay_selector.h"
+
+typedef struct DelayDevice {
+    DelaySelector select;
+    CRITICAL_SECTION lock;
+    HANDLE stop, available, timer, poll_timer, picker, producer;
+    volatile LONG failed;
+    int initialized;
+    int64_t slot;
+    AVFrame *out[DELAY_OUTPUTS];
+    unsigned head, count;
+} DelayDevice;
--- /dev/null
+++ b/libavfilter/delay_device.h
@@ -0,0 +1,213 @@
+/* Only the producer touches desktop duplication. Only the graph thread calls
+ * ff_filter_frame. The picker uses neither the capture device nor the graph. */
+static void delay_fail(DelayDevice *d,int err)
+{
+    InterlockedCompareExchange(&d->failed,err,0);
+    SetEvent(d->stop);
+}
+static int delay_wait(DelayDevice *d,HANDLE timer,int64_t due)
+{
+    HANDLE h[2]={d->stop,timer};
+    for(;;) {
+        if(WaitForSingleObject(d->stop,0)==WAIT_OBJECT_0) return 0;
+        int64_t left=due-queue_now();
+        if(left<=0) return 1;
+        LARGE_INTEGER time;
+        time.QuadPart=-av_rescale_rnd(left,10000000,d->select.hz,AV_ROUND_UP);
+        if(!SetWaitableTimer(timer,&time,0,NULL,NULL,FALSE)) return -1;
+        DWORD v=WaitForMultipleObjects(2,h,FALSE,INFINITE);
+        if(v==WAIT_OBJECT_0) return 0;
+        if(v!=WAIT_OBJECT_0+1) return -1;
+    }
+}
+
+/* The duplicated surface and recorded presentation stamp are read under the
+ * same acquisition. Each copy owns a new hwframe until all picks/encoder refs
+ * drop it. The desktop-only buffer in next_frame_internal is never published. */
+static int delay_snapshot(AVFilterContext *ctx,int first)
+{
+    DdagrabContext *dda=ctx->priv;
+    DelayDevice *d=&dda->delay;
+    ID3D11Texture2D *texture=NULL;
+    AVFrame *frame=NULL;
+    int r=0,owned=0;
+    dda->device_hwctx->lock(dda->device_hwctx->lock_ctx);
+    if(first) {
+        texture=dda->probed_texture; dda->probed_texture=NULL;
+        if(!texture){r=AVERROR_BUG;goto finish;}
+    } else {
+        r=next_frame_internal(ctx,&texture,0);
+        if(r<0) goto finish;
+    }
+    owned=1;
+    if(!first && !dda->delay_changed) goto finish;
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D_GetDesc(texture,&desc);
+    if(desc.Format!=DXGI_FORMAT_B8G8R8A8_UNORM || desc.Width!=1920 || desc.Height!=1080 ||
+       desc.ArraySize!=1 || desc.MipLevels!=1 || desc.SampleDesc.Count!=1) {
+        r=AVERROR_OUTPUT_CHANGED;goto finish;
+    }
+    frame=av_frame_alloc();
+    if(!frame){r=AVERROR(ENOMEM);goto finish;}
+    r=av_hwframe_get_buffer(dda->frames_ref,frame,0);
+    if(r<0) goto finish;
+    ID3D11DeviceContext_CopySubresourceRegion(dda->device_hwctx->device_context,
+        (ID3D11Resource*)frame->data[0],(UINT)(intptr_t)frame->data[1],0,0,0,(ID3D11Resource*)texture,0,NULL);
+    if(dda->draw_mouse) {
+        r=draw_mouse_pointer(ctx,frame);
+        ID3D11DeviceContext_OMSetRenderTargets(dda->device_hwctx->device_context,0,NULL,NULL);
+        if(r<0) goto finish;
+    }
+    frame->color_range=AVCOL_RANGE_JPEG; frame->color_primaries=AVCOL_PRI_BT709;
+    frame->color_trc=AVCOL_TRC_IEC61966_2_1; frame->colorspace=AVCOL_SPC_RGB;
+    frame->sample_aspect_ratio=(AVRational){1,1};
+finish:
+    release_resource(&texture);
+    if(owned && FAILED(IDXGIOutputDuplication_ReleaseFrame(dda->dxgi_outdupl))) r=AVERROR_EXTERNAL;
+    dda->device_hwctx->unlock(dda->device_hwctx->lock_ctx);
+    if(r>=0 && frame) {
+        EnterCriticalSection(&d->lock);
+        r=delay_publish(&d->select,frame,dda->delay_present,dda->delay_cursor,queue_now());
+        if (r >= 0) frame = NULL;
+        LeaveCriticalSection(&d->lock);
+    }
+    av_frame_free(&frame);
+    return r==AVERROR(EAGAIN)?0:r;
+}
+
+static unsigned __stdcall delay_produce(void *opaque)
+{
+    AVFilterContext *ctx=opaque;
+    DdagrabContext *dda=ctx->priv;
+    DelayDevice *d=&dda->delay;
+    for(;;) {
+        int64_t now=queue_now();
+        int64_t tick=av_rescale_rnd(now-d->select.epoch,240,d->select.hz,AV_ROUND_DOWN)+1;
+        int64_t due=d->select.epoch+av_rescale_rnd(tick,d->select.hz,240,AV_ROUND_UP);
+        int w=delay_wait(d,d->poll_timer,due);
+        if(w<=0){if(w<0)delay_fail(d,AVERROR_EXTERNAL);break;}
+        int r=delay_snapshot(ctx,0);
+        if(r<0){delay_fail(d,r);break;}
+    }
+    return 0;
+}
+
+/* Called under the selector lock. Reaching a capacity or excessive lateness
+ * is a capture error, never permission to drop a slot or introduce a PTS gap. */
+static int delay_emit(DelayDevice *d, int64_t wake)
+{
+    int64_t due = delay_due(&d->select, d->slot);
+    AVFrame *frame = NULL;
+    if (wake - due > d->select.hz / 2)
+        return AVERROR(ETIMEDOUT);
+    int ret = delay_pick(&d->select, d->slot, wake, &frame);
+    if (ret < 0)
+        return ret;
+    if (frame) {
+        if (d->count == DELAY_OUTPUTS) {
+            av_frame_free(&frame);
+            return AVERROR(ENOBUFS);
+        }
+        d->out[(d->head + d->count) % DELAY_OUTPUTS] = frame;
+        d->count++;
+        SetEvent(d->available);
+    }
+    d->slot++;
+    return 0;
+}
+
+static AVFrame *delay_take(DelayDevice *d)
+{
+    AVFrame *frame = d->out[d->head];
+    d->out[d->head] = NULL;
+    d->head = (d->head + 1) % DELAY_OUTPUTS;
+    if (--d->count == 0)
+        ResetEvent(d->available);
+    return frame;
+}
+
+static unsigned __stdcall delay_timer(void *opaque)
+{
+    DelayDevice *d = opaque;
+    while (!d->failed) {
+        int w = delay_wait(d, d->timer, delay_due(&d->select, d->slot));
+        if (w <= 0) {
+            if (w < 0) delay_fail(d, AVERROR_EXTERNAL);
+            break;
+        }
+        EnterCriticalSection(&d->lock);
+        int ret = delay_emit(d, queue_now());
+        LeaveCriticalSection(&d->lock);
+        if (ret < 0) {
+            delay_fail(d, ret);
+            break;
+        }
+    }
+    return 0;
+}
+
+static int delay_start(AVFilterContext *ctx)
+{
+    DdagrabContext *dda=ctx->priv;
+    DelayDevice *d=&dda->delay;
+    LARGE_INTEGER hz;
+    int64_t now=queue_now();
+    if(!QueryPerformanceFrequency(&hz) || dda->delay_epoch<=0 || dda->delay_epoch>now) return AVERROR(EINVAL);
+    d->select.epoch=dda->delay_epoch; d->select.hz=hz.QuadPart;
+    InitializeCriticalSection(&d->lock); d->initialized=1;
+    d->stop=CreateEventW(NULL,TRUE,FALSE,NULL); d->available=CreateEventW(NULL,TRUE,FALSE,NULL);
+    d->timer=CreateWaitableTimerExW(NULL,NULL,CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,TIMER_ALL_ACCESS);
+    d->poll_timer=CreateWaitableTimerExW(NULL,NULL,CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,TIMER_ALL_ACCESS);
+    if(!d->stop || !d->available || !d->timer || !d->poll_timer) return AVERROR_EXTERNAL;
+    dda->time_timeout=0;
+    int r=delay_snapshot(ctx,1);
+    if(r<0) return r;
+    /* Start with the first deadline that could have included the probed
+     * texture. Never fill time before a real texture was published. */
+    int64_t ready=d->select.input[0].ready;
+    d->slot=FFMAX(0,av_rescale_rnd(ready-d->select.epoch,60,d->select.hz,AV_ROUND_DOWN)-1);
+    d->producer=(HANDLE)_beginthreadex(NULL,0,delay_produce,ctx,0,NULL);
+    d->picker=(HANDLE)_beginthreadex(NULL,0,delay_timer,d,0,NULL);
+    return d->producer && d->picker?0:AVERROR_EXTERNAL;
+}
+
+static int delay_request(AVFilterLink *out)
+{
+    DdagrabContext *dda=out->src->priv;
+    DelayDevice *d=&dda->delay;
+    HANDLE events[]={d->stop,d->available};
+    for(;;) {
+        DWORD w=WaitForMultipleObjects(2,events,FALSE,50);
+        if(w==WAIT_TIMEOUT && !startup_interrupted()) continue;
+        if(w!=WAIT_OBJECT_0+1) return d->failed?d->failed:AVERROR_EXIT;
+        EnterCriticalSection(&d->lock);
+        if(!d->count){LeaveCriticalSection(&d->lock);continue;}
+        AVFrame *frame = delay_take(d);
+        LeaveCriticalSection(&d->lock);
+        return ff_filter_frame(out,frame);
+    }
+}
+
+static void delay_close(DelayDevice *d)
+{
+    if(!d->initialized) return;
+    if(d->stop) SetEvent(d->stop);
+    HANDLE threads[2]; unsigned thread_count=0;
+    if(d->producer) threads[thread_count++]=d->producer;
+    if(d->picker) threads[thread_count++]=d->picker;
+    if(thread_count && WaitForMultipleObjects(thread_count,threads,TRUE,3000)!=WAIT_OBJECT_0){
+        /* A stuck driver thread may still access the device and selector.
+         * Terminate this capture child without releasing their memory. */
+        av_log(NULL,AV_LOG_FATAL,"Desktop capture worker closure exceeded 3000 ms\n");
+        TerminateProcess(GetCurrentProcess(),124);
+        abort();
+    }
+    for(unsigned i=0;i<thread_count;i++) CloseHandle(threads[i]);
+    for(unsigned i=0;i<DELAY_OUTPUTS;i++) av_frame_free(&d->out[i]);
+    delay_clear(&d->select);
+    if(d->stop)CloseHandle(d->stop);
+    if(d->available)CloseHandle(d->available);
+    if(d->timer)CloseHandle(d->timer);
+    if(d->poll_timer)CloseHandle(d->poll_timer);
+    DeleteCriticalSection(&d->lock);d->initialized=0;
+}
